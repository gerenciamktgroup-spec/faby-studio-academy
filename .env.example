# FABY STUDIO ACADEMY — Variables de Entorno para Producción

# 1. Configuración de Entorno
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://fabystudio.academy

# 2. Supabase PostgreSQL 15 & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Pasarelas de Pago (Producción)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 4. WhatsApp Business API / Admisiones
NEXT_PUBLIC_WHATSAPP_PHONE=34600000000

# 5. Parámetros de Trazabilidad & Heartbeat
NEXT_PUBLIC_HEARTBEAT_INTERVAL_SECONDS=45
