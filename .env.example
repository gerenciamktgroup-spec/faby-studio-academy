# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Used only on the server to irreversibly hash IP addresses in audit records.
# Generate at least 32 random characters and never expose it as NEXT_PUBLIC_*.
AUDIT_IP_HASH_SALT=replace-with-a-random-secret-of-at-least-32-characters
CERTIFICATE_SIGNING_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters

# Preview stays closed until the legal identity and public privacy notice are approved.
ENABLE_PUBLIC_REGISTRATION=false

# Required only by live CI/catalog verification.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_ACCESS_TOKEN=YOUR_MANAGEMENT_API_TOKEN
SUPABASE_DB_PASSWORD=YOUR_STAGING_DATABASE_PASSWORD

# Public canonical URL used by auth redirects and certificate verification.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=
